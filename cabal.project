-- Custom repository for Cardano Haskell packages (cardano-api, ouroboros-*,
-- typed-protocols, cardano-slotting all live here, not on Hackage).
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- Match cardano-api's own index-state so the source-repository-package below
-- (cardano-api master, 11.3) resolves its dependency set.
index-state:
  , hackage.haskell.org 2026-07-01T00:33:51Z
  , cardano-haskell-packages 2026-06-29T12:05:19Z

active-repositories:
  , :rest
  , cardano-haskell-packages:override

with-compiler: ghc-9.10.3

-- Mirror the dependency workarounds from cardano-api's own cabal.project that a
-- from-source build of it needs. cardano-api requires aeson >= 2.3, which
-- conflicts with the upper bounds of cborg-json and friends; allow-newer relaxes
-- those. (cardano-api's WASM-only source-repository-packages are not needed for
-- a native ghc-9.10.3 build.)
allow-newer:
  , cborg-json:aeson
  , criterion-measurement:aeson
  , deriving-aeson:aeson
  , grapesy:aeson
  , grpc-spec:aeson
  , hedgehog-extras:aeson
  , microstache:aeson
  , monad-control:transformers
  , http-api-data:text-iso8601

constraints:
  , any.crypton-x509-system < 1.6.8

package crypton
  flags: -support_rdrand

package bitvec
  flags: -simd

-- Build cardano-api from our branch instead of the released CHaP version, so we
-- can extend cardano-api as sieve needs it. Currently carries PR #1262, which
-- re-exports the ledger accessors auxDataTxL / metadataTxAuxDataL used to read
-- transaction metadata. No local version pin — the SRP is the source of truth.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-api
  tag: f202918f146b03e5b69280fdcb78eb78fcd20233
  subdir: cardano-api

packages: .
